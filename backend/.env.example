# Copy to backend/.env and fill in. Never commit the real file.

ENVIRONMENT=development

# --- Fraud-prediction storage: "sqlite" (local) or "supabase" (PostgreSQL with Row Level Security) ---
DB_BACKEND=sqlite

# --- Application database (store, orders, cases, ScamWatch, security events, audit) ---
# Leave empty for a local SQLite file at backend/data/fraudguard_app.db.
# A PostgreSQL URL also works if you install a driver (for example: postgresql+psycopg://user:pass@host/db).
DATABASE_URL=
SEED_DEMO_DATA=true

# --- Supabase (needed for real sign-in and for DB_BACKEND=supabase) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# HS256 projects: Project Settings -> API -> JWT Secret. Leave EMPTY if your project uses asymmetric
# signing keys; the API then verifies tokens via SUPABASE_URL/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=

# --- Local DEMONSTRATION sign-in (no Supabase needed). NEVER enable on a server other people can reach. ---
# true  = adds POST /auth/local/login and creates 4 demo accounts (see README for the demo password)
LOCAL_AUTH_ENABLED=false
# Optional. Empty = a random secret is created in backend/data/local_auth_secret.txt (git-ignored).
LOCAL_AUTH_SECRET=

# --- Models ---
# Optional override of the decision threshold stored in the model file (0 to 1).
MODEL_THRESHOLD=
RISK_HIGH=0.7
RISK_MEDIUM=0.3

# --- Web ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DOCS_ENABLED=true

# --- Rate limits (requests per minute) ---
PREDICT_RATE_LIMIT_PER_MIN=30
CHECKOUT_RATE_LIMIT_PER_MIN=10
CART_RATE_LIMIT_PER_MIN=120
SCAMWATCH_RATE_LIMIT_PER_MIN=20
LOGIN_RATE_LIMIT_PER_MIN=10

# --- Store identity (a retailer-authorised deployment would change these) ---
STORE_NAME=FreshCart Demo Store
STORE_CURRENCY=ZAR
STORE_IS_DEMO=true
DELIVERY_FEE_CENTS=3500
FREE_DELIVERY_OVER_CENTS=60000
DELIVERY_CITIES=Johannesburg,Pretoria,Cape Town,Durban

# --- ScamWatch ---
# Comma-separated: heuristic (offline, default), safebrowsing (needs a key; sends the URL to Google)
SCAMWATCH_PROVIDERS=heuristic
SAFE_BROWSING_API_KEY=
SCAMWATCH_PROTECTED_BRANDS=shoprite
SCAMWATCH_OFFICIAL_DOMAINS=shoprite.co.za,shoprite.co.zm
