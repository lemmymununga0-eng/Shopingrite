# Copy to backend/.env and fill in. Never commit the real file.

ENVIRONMENT=development

# --- Where staff "New Payment" predictions are stored ---
#   sqlite   = a local file (development only: lost when a host redeploys)
#   app      = the application database below (use this in production, with PostgreSQL)
#   supabase = Supabase tables with Row Level Security
DB_BACKEND=sqlite

# --- Application database (store, orders, cases, ScamWatch, security events, audit) ---
# Leave empty for a local SQLite file at backend/data/fraudguard_app.db.
# A PostgreSQL URL also works if you install a driver (for example: postgresql+psycopg://user:pass@host/db).
DATABASE_URL=
SEED_DEMO_DATA=true
PAYMENT_HOLD_MINUTES=30
COD_ENABLED=false
PAYMENTS_SIMULATED_ENABLED=true
PAYMENT_WEBHOOK_SECRET=

# --- Real payments through Flutterwave (card + MTN / Airtel mobile money, ZMW) ---
# Leave FLW_SECRET_KEY empty to switch real payments off. Use the TEST key (FLWSECK_TEST-...) until you have gone live.
FLW_SECRET_KEY=
# The "secret hash" you type into Flutterwave's dashboard (Settings > Webhooks). Any long random string.
FLW_WEBHOOK_HASH=
# Where customers return after paying (your website's address, no trailing slash).
FRONTEND_URL=http://localhost:5173
SEED_ZM_CATALOGUE=true
SEED_LEGACY_DEMO=false

# --- Supabase (needed for real sign-in and for DB_BACKEND=supabase) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# HS256 projects: Project Settings -> API -> JWT Secret. Leave EMPTY if your project uses asymmetric
# signing keys; the API then verifies tokens via SUPABASE_URL/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=

# --- Local DEMONSTRATION sign-in (no Supabase needed). NEVER enable on a server other people can reach. ---
# true  = adds POST /auth/local/login and creates 4 demo accounts (see README for the demo password)
LOCAL_AUTH_ENABLED=false
# Optional. Empty = a random secret is created in backend/data/local_auth_secret.txt (git-ignored).
LOCAL_AUTH_SECRET=

# --- Models ---
# Optional override of the decision threshold stored in the model file (0 to 1).
MODEL_THRESHOLD=
RISK_HIGH=0.7
RISK_MEDIUM=0.3

# --- Web ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DOCS_ENABLED=true

# --- Rate limits (requests per minute) ---
PREDICT_RATE_LIMIT_PER_MIN=30
CHECKOUT_RATE_LIMIT_PER_MIN=10
CART_RATE_LIMIT_PER_MIN=120
SCAMWATCH_RATE_LIMIT_PER_MIN=20
LOGIN_RATE_LIMIT_PER_MIN=10

# --- Store identity (a retailer-authorised deployment would change these) ---
STORE_NAME=FreshCart Demo Store
STORE_CURRENCY=ZMW
STORE_IS_DEMO=true
# true = ONLY administrators can enter the staff console (analyst accounts are treated as customers)
CONSOLE_ADMIN_ONLY=false
# Required when STORE_IS_DEMO=false (shown on the Contact, Terms and Privacy pages):
STORE_LEGAL_NAME=
STORE_CONTACT_EMAIL=
STORE_CONTACT_PHONE=
STORE_CONTACT_ADDRESS=
DELIVERY_FEE_CENTS=3500
FREE_DELIVERY_OVER_CENTS=60000
DELIVERY_CITIES=Lusaka,Kitwe,Ndola,Livingstone

# --- ScamWatch ---
# Comma-separated: heuristic (offline, default), safebrowsing (needs a key; sends the URL to Google)
SCAMWATCH_PROVIDERS=heuristic
# Add ml_url to also use the trained URL-text model (only if backend/artifacts/fraud/url_phishing exists; see docs/ML_EVALUATION.md):
# SCAMWATCH_PROVIDERS=heuristic,ml_url
# Where trained model versions live (default backend/artifacts/fraud; use a persistent disk in production):
# ML_ARTIFACT_DIR=
SAFE_BROWSING_API_KEY=
SCAMWATCH_PROTECTED_BRANDS=shoprite
SCAMWATCH_OFFICIAL_DOMAINS=shoprite.co.za,shoprite.co.zm

# --- Optional customer e-mail (order confirmed, progress, cancelled, refunded). Empty SMTP_HOST = no e-mail is sent. ---
# Any SMTP service works (Brevo, SendGrid, Mailgun, Zoho, Gmail app password ...). Use the details your provider gives you.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
