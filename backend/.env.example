# Copy to backend/.env and fill in. Never commit the real file.

# "sqlite" = local development (no Supabase needed, but you still need a JWT secret to sign in tokens)
# "supabase" = Supabase Postgres with Row Level Security (production-like)
DB_BACKEND=sqlite

# --- Supabase (required for DB_BACKEND=supabase and for verifying real user tokens) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# HS256 projects: Project Settings -> API -> JWT Secret. Leave EMPTY if your project uses asymmetric
# signing keys; the API then verifies tokens via SUPABASE_URL/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=

# --- Optional ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PREDICT_RATE_LIMIT_PER_MIN=30
